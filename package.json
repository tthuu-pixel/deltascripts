{
  "name": "deltascript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "dev:api": "node scripts/wrangler.mjs dev --local --port 3001 --persist-to .data/d1",
    "build": "vite build && node scripts/wrangler.mjs deploy --dry-run --outdir .data/worker-build",
    "start": "node scripts/wrangler.mjs dev --local --port 3000 --persist-to .data/d1",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:tikz": "node test-tikz.js",
    "admin:create": "tsx server/admin.ts",
    "admin:setup": "tsx server/setup-link.ts",
    "format": "prettier --write src server shared scripts tests *.ts *.json",
    "format:check": "prettier --check src server shared scripts tests *.ts *.json",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply DB --local --persist-to .data/d1",
    "db:migrate:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "cf:login": "node scripts/wrangler.mjs login",
    "cf:whoami": "node scripts/wrangler.mjs whoami --json",
    "cf:setup": "node scripts/cloudflare-setup.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20261019.1-beta",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "undici": "7.29.1",
    "vite": "^6.2.0",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
